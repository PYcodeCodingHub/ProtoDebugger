-- Output Text (Larger for Visibility)
local function addConsoleOutput(text, textColor)
    local newOutput = Instance.new("TextLabel")
    newOutput.Size = UDim2.new(1, 0, 0, 0)
    newOutput.TextWrapped = true
    newOutput.TextYAlignment = Enum.TextYAlignment.Top
    newOutput.TextColor3 = textColor or Color3.fromRGB(255, 255, 255)
    newOutput.Font = Enum.Font.GothamBold -- Better legibility
    newOutput.TextSize = 18 -- Larger for accessibility
    newOutput.BackgroundTransparency = 1
    newOutput.Text = text
    newOutput.Parent = OutputFrame
    newOutput.Size = UDim2.new(1, 0, 0, newOutput.TextBounds.Y + 10)
    updateCanvasSize()
end
